DATABASE_URL=file:./local.db
DATABASE_AUTH_TOKEN=
# En Vercel también se aceptan TURSO_DATABASE_URL y TURSO_AUTH_TOKEN de la integración nativa.
# db:seed genera esta clave una sola vez en SQLite local si está vacía.
# En Vercel configurar una clave propia aleatoria de al menos 32 bytes; no guardar aquí un valor real.
SESSION_SECRET=
# Opcional: contraseña exclusiva para las cuentas de demostración al cargar una base vacía.
# Si se omite, la demo local usa DemoFerreteria123! (credencial pública; nunca usarla con datos reales).
SEMILLA_PASSWORD=
